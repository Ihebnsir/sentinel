<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permission « normale » (aucune demande à l'utilisateur) :
         nécessaire pour savoir si une biométrie est enregistrée. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Voir toutes les applications installées (Android 11+).
         Google Play l'autorise pour les apps de sécurité / antivirus,
         à condition de remplir la déclaration dans la Play Console. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- « Accès sensibles » : autorisation spéciale « Accès aux données
         d'utilisation » (pas une permission dangereuse). L'utilisateur
         l'active lui-même dans les réglages, après explication ; on lit
         seulement quand les apps étaient ouvertes ou actives (7 jours). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Permission « normale » : ouvrir l'écran de désinstallation d'une app.
         C'est toujours l'utilisateur qui confirme. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Android 13+ : afficher les alertes du pare-feu et le rappel du
         bilan de la semaine. Demandée seulement quand on active l'un des deux. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permission « normale » : lire l'état du réseau (Wi-Fi, portail captif,
         DNS privé). Aucune localisation : on ne lit jamais le nom du Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Internet, toujours après accord : Have I Been Pwned (fuites de mots
         de passe, seuls 5 caractères d'empreinte sont envoyés), transfert
         des requêtes DNS du pare-feu vers Quad9, et mise à jour des listes
         de blocage (simples téléchargements, rien sur l'utilisateur). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pare-feu DNS : service au premier plan (notification permanente).
         Android 14+ : type « systemExempted », celui prévu pour les VPN. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Fin d'une analyse d'app à l'heure exacte, même téléphone en veille
         (la fenêtre sans protection ne s'allonge pas). Accordée d'office
         sur Android 12-13 ; Android 14+ : réveil inexact si refusée. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Permission « normale » : après un redémarrage, reprogrammer la
         suppression des rapports d'analyse à 24 h (BootReceiver), et garder
         la tâche quotidienne du bilan de la semaine (setPersisted). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Caméra : pour « Scanner un QR code » (onglet Liens) et la photo
         d'un document du coffre, demandée au moment de l'utiliser. L'image
         du QR n'est ni enregistrée ni envoyée ; la photo est chiffrée.
         Déjà ajoutée par zxing-android-embedded ; écrite ici pour être vue.
         Pas exigée : l'app s'installe aussi sans caméra. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Pas de sauvegarde Android : le coffre (même chiffré) ne doit pas
         partir dans le cloud ni vers un autre téléphone.
         allowBackup="false" suffit jusqu'à Android 11 ; à partir d'Android 12,
         dataExtractionRules exclut aussi le transfert d'appareil à appareil. -->
    <application
        android:label="Sentinel"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Bouton « Partager » des autres apps (navigateur, SMS…) :
                 Sentinel apparaît quand on partage un lien ou du texte.
                 L'onglet Liens y cherche le premier lien. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Menu de sélection de texte (Copier, Coller…) de toutes les apps :
                 vérifier le lien sélectionné. Le label est le texte du menu. -->
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Écran de scan de QR code (zxing-android-embedded). Non exporté :
             seul Sentinel l'ouvre. Suit le sens du téléphone (paysage par
             défaut dans la bibliothèque). -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            tools:replace="android:screenOrientation" />
        <!-- Aucun lecteur de notifications, service d'accessibilité ni accès
             aux SMS (vérifié par checkPlayProtect*, build.gradle.kts). -->
        <!-- Pare-feu DNS local. BIND_VPN_SERVICE : seul Android peut s'y
             connecter. exported="true" est obligatoire pour un VpnService
             (le système le démarre, ex : VPN permanent). -->
        <service
            android:name=".firewall.SentinelVpnService"
            android:exported="true"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <!-- Tuile « Pare-feu Sentinel » des Paramètres rapides.
             BIND_QUICK_SETTINGS_TILE : seul Android (le panneau) peut s'y
             connecter. exported="true" est obligatoire pour une tuile. -->
        <service
            android:name=".firewall.FirewallTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_arch"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Supprime les rapports d'analyse d'app après 24 h (réveil d'Android).
             exported="false" : aucune autre app ne peut le déclencher. -->
        <receiver
            android:name=".firewall.ReportCleanupReceiver"
            android:exported="false" />
        <!-- Reprogramme ce nettoyage après un redémarrage ou une mise à jour
             (Android efface alors les alarmes). Ces deux diffusions sont
             protégées : seul le système peut les envoyer. -->
        <receiver
            android:name=".firewall.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Bilan de la semaine : tâche quotidienne d'Android (JobScheduler),
             lancée seulement par le système (BIND_JOB_SERVICE). Pas de service
             permanent : elle efface les vieilles semaines et, si l'option est
             activée, prévient le lundi que le bilan est prêt. -->
        <service
            android:name=".weekly.WeeklyReportJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Photo d'un document du coffre : l'appareil photo d'Android écrit
             dans cache/vault_capture (lue puis effacée aussitôt).
             Non exporté : accès accordé à la seule app photo lancée. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.vaultcapture"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/vault_capture_paths" />
        </provider>
        <!-- Partage d'un document du coffre, choisi par l'utilisateur :
             octets servis depuis la mémoire, jamais de fichier en clair.
             Non exporté : seule l'app choisie reçoit l'accès. -->
        <provider
            android:name=".VaultShareProvider"
            android:authorities="${applicationId}.vaultshare"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
