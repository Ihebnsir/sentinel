<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permission « normale » (aucune demande à l'utilisateur) :
         nécessaire pour savoir si une biométrie est enregistrée. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Voir toutes les applications installées (Android 11+).
         Google Play l'autorise pour les apps de sécurité / antivirus,
         à condition de remplir la déclaration dans la Play Console. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Permission « normale » : ouvrir l'écran de désinstallation d'une app.
         C'est toujours l'utilisateur qui confirme. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Android 13+ : afficher les alertes « Arnaque probable ».
         Demandée seulement quand l'utilisateur active la protection. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permission « normale » : lire l'état du réseau (Wi-Fi, portail captif,
         DNS privé). Aucune localisation : on ne lit jamais le nom du Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Internet, toujours après accord : Have I Been Pwned (fuites de mots
         de passe, seuls 5 caractères d'empreinte sont envoyés), transfert
         des requêtes DNS du pare-feu vers Quad9, et mise à jour des listes
         de blocage (simples téléchargements, rien sur l'utilisateur). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pare-feu DNS : service au premier plan (notification permanente).
         Android 14+ : type « systemExempted », celui prévu pour les VPN. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Fin d'une analyse d'app à l'heure exacte, même téléphone en veille
         (la fenêtre sans protection ne s'allonge pas). Accordée d'office
         sur Android 12-13 ; Android 14+ : réveil inexact si refusée. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Permission « normale » : après un redémarrage, reprogrammer la
         suppression des rapports d'analyse à 24 h (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Pas de sauvegarde Android : le coffre (même chiffré) ne doit pas
         partir dans le cloud ni vers un autre téléphone.
         allowBackup="false" suffit jusqu'à Android 11 ; à partir d'Android 12,
         dataExtractionRules exclut aussi le transfert d'appareil à appareil. -->
    <application
        android:label="Sentinel"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Bouton « Partager » des autres apps (SMS, WhatsApp…) :
                 Sentinel apparaît dans la liste quand on partage du texte. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Menu de sélection de texte (Copier, Coller…) de toutes les apps.
                 Le label est le texte affiché dans ce menu. -->
            <intent-filter android:label="Vérifier avec Sentinel">
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Tap sur une alerte « Arnaque probable » (SEN-06).
             exported="false" : seule la notification de Sentinel peut l'ouvrir.
             Elle transmet le texte à MainActivity par la mémoire, puis se ferme
             sans rien afficher (Theme.NoDisplay). -->
        <activity
            android:name=".AlertRelayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Protection automatique : lit les notifications des messageries.
             Seul Android peut s'y connecter (permission BIND_NOTIFICATION_LISTENER_SERVICE),
             et seulement si l'utilisateur l'a autorisé dans les réglages. -->
        <service
            android:name=".SentinelNotificationListener"
            android:label="Sentinel – protection anti-arnaque"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Android 12+ : ne recevoir que les conversations et les
                 notifications qui sonnent (pas les permanentes ni les silencieuses). -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
        </service>
        <!-- Pare-feu DNS local. BIND_VPN_SERVICE : seul Android peut s'y
             connecter. exported="true" est obligatoire pour un VpnService
             (le système le démarre, ex : VPN permanent). -->
        <service
            android:name=".firewall.SentinelVpnService"
            android:exported="true"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <!-- Supprime les rapports d'analyse d'app après 24 h (réveil d'Android).
             exported="false" : aucune autre app ne peut le déclencher. -->
        <receiver
            android:name=".firewall.ReportCleanupReceiver"
            android:exported="false" />
        <!-- Reprogramme ce nettoyage après un redémarrage ou une mise à jour
             (Android efface alors les alarmes). Ces deux diffusions sont
             protégées : seul le système peut les envoyer. -->
        <receiver
            android:name=".firewall.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
