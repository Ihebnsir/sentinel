<!-- Variante « complete » (future version Google Play) uniquement.
     La variante « standard » (APK GitHub) n'a pas ce service : Google Play
     Protect bloque hors Play Store les apps qui déclarent un lecteur de
     notifications (vérifié par la tâche checkPlayProtectStandard*). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Protection automatique : lit les notifications des messageries.
             Seul Android peut s'y connecter (permission BIND_NOTIFICATION_LISTENER_SERVICE),
             et seulement si l'utilisateur l'a autorisé dans les réglages. -->
        <service
            android:name=".SentinelNotificationListener"
            android:label="@string/listener_label"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Android 12+ : ne recevoir que les conversations et les
                 notifications qui sonnent (pas les permanentes ni les silencieuses). -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
        </service>
    </application>
</manifest>
