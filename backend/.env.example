# Exemple de configuration : copier en .env (jamais commité) et adapter.
# En production (Render), les mêmes variables sont dans render.yaml.

# dev : /docs ouvert, contrôles souples. prod (défaut) : /docs fermé, et
# démarrage refusé sans TLS vers PostgreSQL ou sans clé d'empreinte.
SENTINEL_ENV=dev

# SQLite (dev) ou PostgreSQL (driver psycopg 3, TLS obligatoire en prod) :
#   postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/BASE?sslmode=require
SENTINEL_DATABASE_URL=sqlite:///./data/sentinel.db
# Migrations avec un autre rôle (propriétaire) ; vide = même URL.
SENTINEL_MIGRATION_DATABASE_URL=
# SQLite autorisé en prod seulement si true (disque éphémère chez l'hébergeur).
SENTINEL_ALLOW_SQLITE=false

SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
SENTINEL_LOG_LEVEL=INFO

# Limite par adresse (par fenêtre en secondes) et limite globale par jour.
SENTINEL_RATE_LIMIT_PER_WINDOW=10
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=3600
SENTINEL_RATE_LIMIT_MAX_KEYS=100000
SENTINEL_GLOBAL_DAILY_LIMIT=500

# Taille maximale d'une requête, en octets.
SENTINEL_MAX_BODY_BYTES=16384

# Derrière le proxy de l'hébergeur SEULEMENT : IP du client lue dans cet
# en-tête (n-ième entrée en partant de la droite). Sinon : IP de connexion.
SENTINEL_TRUST_PROXY=false
SENTINEL_CLIENT_IP_HEADER=x-forwarded-for
SENTINEL_PROXY_HOPS=1

# Clé HMAC des empreintes de texte (doublons). Obligatoire en prod (32
# caractères ou plus, aléatoire, secrète). Vide en dev : clé de développement.
SENTINEL_FINGERPRINT_KEY=

# Rétention (outil tools.retention), en jours.
SENTINEL_RETENTION_REJECTED_DAYS=183
SENTINEL_RETENTION_NEW_DAYS=365
