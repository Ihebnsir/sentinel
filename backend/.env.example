# Exemple de configuration : copier en .env (jamais commité) et adapter.
# Aucun secret n'est nécessaire : le sel de la limite de débit est tiré au
# hasard en mémoire au démarrage, puis à chaque nouvelle fenêtre.

# dev : /docs et /openapi.json ouverts. prod (défaut) : fermés.
SENTINEL_ENV=dev
SENTINEL_DATABASE_URL=sqlite:///./data/sentinel.db
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
SENTINEL_LOG_LEVEL=INFO

# Limite de débit : signalements par adresse et par fenêtre (secondes).
SENTINEL_RATE_LIMIT_PER_WINDOW=10
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=3600
SENTINEL_RATE_LIMIT_MAX_KEYS=100000

# Taille maximale d'une requête, en octets.
SENTINEL_MAX_BODY_BYTES=16384

# Proxys de confiance pour X-Forwarded-For (adresse IP du vrai client).
SENTINEL_FORWARDED_ALLOW_IPS=127.0.0.1
